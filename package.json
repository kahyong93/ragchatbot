{
  "name": "ragchatbot-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Front-end code quality tooling for the Course Materials RAG System UI",
  "scripts": {
    "format": "prettier --write \"frontend/**/*.{html,css,js,json}\"",
    "format:check": "prettier --check \"frontend/**/*.{html,css,js,json}\"",
    "lint": "eslint \"frontend/**/*.js\"",
    "lint:fix": "eslint --fix \"frontend/**/*.js\"",
    "quality": "npm run format:check && npm run lint"
  },
  "devDependencies": {
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "prettier": "^3.4.0"
  }
}
